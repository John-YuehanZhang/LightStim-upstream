{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/John-YuehanZhang/LightStim-upstream/blob/codex/bb-code-ppm/benchmarks/logical_ops/reference/bb_ppm/manifest.schema.json",
  "title": "BB PPM recorded aggregate results, version 1",
  "description": "Structural schema. plot_bb_ppm.read_results additionally verifies the CSV digest, exact row equality, count identities, exact confidence intervals, fixed sample budgets, and requested experiment identity. Original archive references are provenance identifiers, not bundled files.",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "status",
    "results_csv",
    "requested_shots_by_p",
    "rows",
    "experiment",
    "decoder",
    "resources",
    "points"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "bb_ppm_recorded_results"
    },
    "status": {
      "enum": [
        "partial",
        "complete"
      ]
    },
    "results_csv": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[^/\\\\]+\\.csv$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "requested_shots_by_p": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "p",
          "shots",
          "logical_failures",
          "nonconverged",
          "converged_correct",
          "converged_logical_failure",
          "unconverged_correct_observables",
          "unconverged_logical_failure",
          "ler",
          "ler_95_exact_two_sided_low",
          "ler_95_exact_two_sided_high",
          "ler_95_one_sided_upper",
          "nonconvergence_rate",
          "sum_decode_cpu_seconds",
          "source_manifest_sha256",
          "decoder_manifest_sha256"
        ],
        "properties": {
          "p": {
            "type": "number",
            "exclusiveMinimum": 0,
            "exclusiveMaximum": 1
          },
          "shots": {
            "type": "integer",
            "minimum": 1
          },
          "logical_failures": {
            "type": "integer",
            "minimum": 0
          },
          "nonconverged": {
            "type": "integer",
            "minimum": 0
          },
          "converged_correct": {
            "type": "integer",
            "minimum": 0
          },
          "converged_logical_failure": {
            "type": "integer",
            "minimum": 0
          },
          "unconverged_correct_observables": {
            "type": "integer",
            "minimum": 0
          },
          "unconverged_logical_failure": {
            "type": "integer",
            "minimum": 0
          },
          "ler": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "ler_95_exact_two_sided_low": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "ler_95_exact_two_sided_high": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "ler_95_one_sided_upper": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "nonconvergence_rate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "sum_decode_cpu_seconds": {
            "type": "number",
            "minimum": 0
          },
          "source_manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "decoder_manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "experiment": {
      "type": "object",
      "required": [
        "target",
        "compiled_plan_sha256",
        "clean_circuit_sha256",
        "noise_model",
        "rounds",
        "initial_state",
        "final_basis"
      ],
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1
        },
        "compiled_plan_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "clean_circuit_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "noise_model": {
          "type": "string",
          "minLength": 1
        },
        "rounds": {
          "type": "integer",
          "minimum": 1
        },
        "initial_state": {
          "type": "string"
        },
        "final_basis": {
          "type": "string"
        }
      }
    },
    "decoder": {
      "type": "object",
      "required": [
        "name",
        "parameters"
      ],
      "properties": {
        "name": {
          "const": "relay-bp"
        },
        "parameters": {
          "type": "object"
        }
      }
    },
    "resources": {
      "type": "object",
      "required": [
        "sequence",
        "physical_qubits",
        "ticks",
        "detectors",
        "observables",
        "plan_sha256",
        "circuit_sha256"
      ],
      "properties": {
        "sequence": {
          "type": "string"
        },
        "physical_qubits": {
          "type": "integer",
          "minimum": 1
        },
        "ticks": {
          "type": "integer",
          "minimum": 0
        },
        "detectors": {
          "type": "integer",
          "minimum": 0
        },
        "observables": {
          "type": "integer",
          "minimum": 1
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "circuit_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "p"
        ],
        "properties": {
          "p": {
            "type": "number",
            "exclusiveMinimum": 0,
            "exclusiveMaximum": 1
          }
        }
      }
    },
    "raw_shots_in_repository": {
      "type": "boolean"
    },
    "execution": {
      "type": "object",
      "properties": {
        "worker_processes": {
          "type": "integer",
          "minimum": 1
        },
        "threads_per_worker": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
